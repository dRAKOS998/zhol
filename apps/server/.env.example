# Port the HTTP + WebSocket server listens on (Render sets PORT automatically).
PORT=3001
HOST=0.0.0.0
# Comma-separated browser origins allowed to open Socket.IO connections. Exact match, no trailing slash.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Public URL of the web app, used to build absolute invite links in acknowledgments (optional).
PUBLIC_WEB_URL=http://localhost:5173
# SQLite database file. Put it on a persistent disk in production (e.g. /var/data/zhol.db on Render).
DATABASE_PATH=./data/zhol.db
# Set to true behind a reverse proxy (nginx, Render) so rate limits use the client IP from X-Forwarded-For.
TRUST_PROXY=false
# House rule: penalty for an unlinked Zhol tile on a losing rack.
ZHOL_UNLINKED_PENALTY=20
# NODE_ENV=production
# Test-only deal harness. Refuses to start unless NODE_ENV=test. Never set in production.
# ZHOL_TEST_HARNESS=1

# Seconds a connected player has per move before the computer plays it (0 = no limit).
ZHOL_TURN_SECONDS=90
# Seconds a disconnected player is waited for before the computer plays for them (0 = wait forever).
ZHOL_AWAY_SECONDS=30
