{
  "name": "@zhol/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "node build.mjs",
    "start": "node dist/index.js",
    "start:test": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@zhol/engine": "1.0.0",
    "@zhol/protocol": "1.0.0",
    "better-sqlite3": "^12.11.1",
