    "socket.io": "^4.8.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.12",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "vitest": "^3.2.7"
  }
}
