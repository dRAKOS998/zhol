{
  "name": "zhol",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/engine",
    "packages/protocol",
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,yellow \"npm run dev -w @zhol/server\" \"npm run dev -w @zhol/web\"",
    "build": "npm run build -w @zhol/server && npm run build -w @zhol/web",
    "start": "npm run start -w @zhol/server",
    "test": "npm run test -w @zhol/engine && npm run test -w @zhol/server",
    "test:e2e": "npm run test:e2e -w @zhol/web",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "typescript": "5.9",
    "typescript-eslint": "^8.72.1"
  }
}
